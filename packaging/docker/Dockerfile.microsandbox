FROM node:24.22.1-bookworm-slim AS openwork-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && npm install -g bun@1.3.14 \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --frozen-lockfile --trust-lockfile --filter openwork-server... \
  && pnpm --filter openwork-server build \
  && pnpm --filter openwork-server build:bin

FROM node:24.22.1-bookworm-slim

ARG OPENWORK_SERVER_VERSION

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=openwork-builder /src/apps/server/dist/bin/openwork-server /usr/local/bin/openwork-server
COPY --from=openwork-builder /src/apps/server/dist/opencode-plugins /opt/openwork/opencode-plugins
COPY --from=openwork-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh

COPY --from=openwork-builder /src/apps/server/src/opencode-v2-artifacts.json /tmp/opencode-v2-artifacts.json

# Bake the same pinned, integrity-checked OpenCode v2 artifact the server would
# download, so the sandbox never fetches an engine at boot.
RUN set -eux; \
  test -n "$OPENWORK_SERVER_VERSION"; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) platform="linux-x64-baseline" ;; \
    arm64) platform="linux-arm64" ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  url="$(node -e 'const c=require("/usr/local/constants.json"); const a=require("/tmp/opencode-v2-artifacts.json"); if(a.version!==c.opencodeV2Version) throw new Error("OpenCode v2 artifact pin mismatch"); process.stdout.write(a.platforms[process.argv[1]].url)' "$platform")"; \
  tmpdir="$(mktemp -d)"; \
  curl -fsSL "$url" -o "$tmpdir/opencode2.tgz"; \
  node -e 'const fs=require("node:fs"); const crypto=require("node:crypto"); const a=require("/tmp/opencode-v2-artifacts.json"); const actual="sha512-"+crypto.createHash("sha512").update(fs.readFileSync(process.argv[2])).digest("base64"); if(actual!==a.platforms[process.argv[1]].integrity) throw new Error("OpenCode v2 archive integrity mismatch")' "$platform" "$tmpdir/opencode2.tgz"; \
  tar -xzf "$tmpdir/opencode2.tgz" -C "$tmpdir" package/bin/opencode; \
  install -m 0755 "$tmpdir/package/bin/opencode" /usr/local/bin/opencode2; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh; \
  rm -rf "$tmpdir" /tmp/opencode-v2-artifacts.json

ENV OPENWORK_OPENCODE2_BIN=/usr/local/bin/opencode2

RUN test -f /opt/openwork/opencode-plugins/openwork-extensions-preview.js \
  && test -f /opt/openwork/opencode-plugins/openwork-context-v2.js \
  && test "$(openwork-server --version)" = "$OPENWORK_SERVER_VERSION" \
  && "$OPENWORK_OPENCODE2_BIN" --version | node -e 'const fs=require("node:fs"); const expected=require("/usr/local/constants.json").opencodeV2Version; const actual=fs.readFileSync(0,"utf8").trim().replace(/^opencode v?/, ""); if(actual!==expected) throw new Error(`OpenCode v2 version mismatch: ${actual}`)'

ENV OPENWORK_EXTENSIONS_PLUGIN_DIR=/opt/openwork/opencode-plugins
ENV OPENWORK_DATA_DIR=/data/openwork-server
ENV OPENWORK_SIDECAR_DIR=/data/sidecars
ENV OPENWORK_WORKSPACE=/workspace

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${OPENWORK_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
